{
  "ConnectionStrings": {
    "ShopEaseConnection": ""
  },

  "EmailSettings": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "SenderEmail": "",
    "SenderName": "",
    "Username": "",
    "Password": "",
    "EnableSsl": true
  },

  "EcommerceApi": {
    "BaseUrl": "https://localhost:44311",
    "Version": "1"
  },

  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "ShopEaseApi",
    "Audience": "ShopEaseClient",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },

  "Session": {
    "TimeoutMinutes": 60,
    "CookieName": "Ecommerce.Web.Session"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },

  "AllowedHosts": "*"
}