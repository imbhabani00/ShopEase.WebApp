@model ShopEase.WebApp.Models.Common.PermissionAssignViewModel
@Html.AntiForgeryToken()

<style>
    .perm-role-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 16px;
        background: linear-gradient(135deg, #eef2ff 0%, #f5f3ff 100%);
        border: 1px solid #e0e7ff;
        border-radius: 10px;
        margin-bottom: 16px;
    }

        .perm-role-header .perm-role-icon {
            width: 38px;
            height: 38px;
            border-radius: 8px;
            background: #4f46e5;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .perm-role-header .perm-role-icon svg {
                width: 18px;
                height: 18px;
                stroke: #fff;
            }

        .perm-role-header .perm-role-label {
            font-size: 10.5px;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: #6366f1;
            font-weight: 600;
            margin: 0;
        }

        .perm-role-header .perm-role-name {
            font-size: 14.5px;
            font-weight: 700;
            color: #1e1b4b;
            margin: 0;
        }

    .perm-table-wrap {
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        overflow: hidden;
        max-height: 400px;
        overflow-y: auto;
    }

    table.perm-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

        table.perm-table thead th {
            position: sticky;
            top: 0;
            background: #f9fafb;
            border-bottom: 1px solid #e5e7eb;
            padding: 10px 8px;
            font-weight: 600;
            color: #374151;
            text-align: center;
            z-index: 1;
        }

            table.perm-table thead th:first-child {
                text-align: left;
                padding-left: 14px;
            }

        table.perm-table tbody tr {
            border-bottom: 1px solid #f1f2f4;
            transition: background .12s ease;
        }

            table.perm-table tbody tr:hover {
                background: #fafaff;
            }

            table.perm-table tbody tr:last-child {
                border-bottom: none;
            }

        table.perm-table td {
            padding: 10px 8px;
            text-align: center;
            vertical-align: middle;
        }

            table.perm-table td:first-child {
                text-align: left;
                padding-left: 14px;
            }

    .module-name-cell {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
        color: #111827;
    }

    .module-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #a5b4fc;
        flex-shrink: 0;
    }

    .perm-checkbox {
        width: 16px;
        height: 16px;
        accent-color: #4f46e5;
        cursor: pointer;
    }

    .select-all-checkbox {
        width: 15px;
        height: 15px;
        accent-color: #6366f1;
        cursor: pointer;
    }

    .permission-empty-state {
        text-align: center;
        padding: 30px 10px;
        color: #9ca3af;
        font-size: 13px;
    }
</style>

<form id="assignPermissionForm" novalidate>
    <input type="hidden" id="RoleId" value="@Model.RoleId" />

    <div class="perm-role-header">
        <div class="perm-role-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            </svg>
        </div>
        <div>
            <p class="perm-role-label">Assigning permissions for</p>
            <p class="perm-role-name">@Model.RoleName</p>
        </div>
    </div>

    @if (Model.Permissions != null && Model.Permissions.Count > 0)
    {
        <div class="perm-table-wrap">
            <table class="perm-table">
                <thead>
                    <tr>
                        <th>Module</th>
                        <th>View</th>
                        <th>Add</th>
                        <th>Edit</th>
                        <th>Delete</th>
                        <th>Inactive</th>
                        <th>Select all</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var module in Model.Permissions)
                    {
                        <tr class="permission-module-block" data-module-id="@module.ModuleId">
                            <td>
                                <div class="module-name-cell">
                                    <span class="module-dot"></span>
                                    @module.ModuleName
                                </div>
                            </td>
                            <td><input type="checkbox" class="perm-checkbox action-checkbox" data-action="CanView" checked="@module.CanView" /></td>
                            <td><input type="checkbox" class="perm-checkbox action-checkbox" data-action="CanAdd" checked="@module.CanAdd" /></td>
                            <td><input type="checkbox" class="perm-checkbox action-checkbox" data-action="CanEdit" checked="@module.CanEdit" /></td>
                            <td><input type="checkbox" class="perm-checkbox action-checkbox" data-action="CanDelete" checked="@module.CanDelete" /></td>
                            <td><input type="checkbox" class="perm-checkbox action-checkbox" data-action="CanInactive" checked="@module.CanInactive" /></td>
                            <td><input type="checkbox" class="select-all-checkbox" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="permission-empty-state">
            <p>No modules found.</p>
        </div>
    }

    <div class="modal-footer" style="padding:14px 0 0;margin-top:14px;border-top:1px solid #eef0f2;">
        <button type="button" class="btn btn-secondary btn-sm" onclick="closePopup()">Cancel</button>
        <button type="button" class="btn btn-primary btn-sm" id="savePermissionBtn">
            <span class="btn-text">Save Permissions</span>
            <span class="btn-spinner hidden"></span>
        </button>
    </div>
</form>

<script src="~/js/role/assignPermission.js"></script>