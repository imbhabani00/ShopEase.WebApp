@using ShopEase.WebApp.Constants
@using ShopEase.WebApp.Models.Permission
@model ShopEase.WebApp.Models.Role.RoleViewModelList
@{
    var permissions = (PermissionViewModel)ViewBag.Permissions;
}

<div class="table-wrap">
    <table class="data-table">
        <thead>
            <tr>
                <th>
                    <a href="javascript:void(0)" class="sort-btn" onclick="SortData('RoleName')">
                        Role Name
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M8 6v12" />
                            <path d="M5 9l3-3 3 3" />
                            <path d="M16 18V6" />
                            <path d="M13 15l3 3 3-3" />
                        </svg>
                    </a>
                </th>
                <th>
                    <a href="javascript:void(0)" class="sort-btn" onclick="SortData('RoleCode')">
                        Role Code
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M8 6v12" />
                            <path d="M5 9l3-3 3 3" />
                            <path d="M16 18V6" />
                            <path d="M13 15l3 3 3-3" />
                        </svg>
                    </a>
                </th>
                <th>
                    <a href="javascript:void(0)" class="sort-btn" onclick="SortData('Status')">
                        Status
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M8 6v12" />
                            <path d="M5 9l3-3 3 3" />
                            <path d="M16 18V6" />
                            <path d="M13 15l3 3 3-3" />
                        </svg>
                    </a>
                </th>
                <th style="width:120px;text-align:right">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Roles != null && Model.Roles.Count > 0)
            {
                @foreach (var role in Model.Roles)
                {
                    <tr>
                        <td class="fw-600">@role.RoleName</td>
                        <td>
                            <span class="badge badge-info">@role.RoleCode</span>
                        </td>
                        <td>
                            @if (role.IsActive)
                            {
                                <span class="badge badge-success">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">Inactive</span>
                            }
                        </td>
                        <td style="text-align:right">
                            <div class="d-flex gap-8 justify-content-end">

                                @if (permissions.Has(PermissionConstants.Role_Edit))
                                {
                                    <button class="btn btn-outline btn-icon btn-sm" title="Edit"
                                            onclick="loadPopup('/Role/RoleEdit?roleId=@role.RoleId','Edit Role','md')">
                                        <svg width="13" height="13" viewBox="0 0 24 24"
                                             fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7" />
                                            <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z" />
                                        </svg>
                                    </button>
                                }

                                @if (permissions.Has(PermissionConstants.Permissions_Edit))
                                {
                                    <button class="btn btn-outline btn-icon btn-sm" title="Assign Permissions"
                                            onclick="loadPopup('/Role/LoadAssignGrid?roleId=@role.RoleId','Assign Permissions','lg')">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                                        </svg>
                                    </button>
                                }

                                @if (permissions.Has(PermissionConstants.Role_Delete))
                                {
                                    <button class="btn btn-danger btn-icon btn-sm" title="Delete"
                                            onclick="loadPopup('/Role/DeleteConfirm?roleId=@role.RoleId','Delete Role','md')">
                                        <svg width="13" height="13" viewBox="0 0 24 24"
                                             fill="none" stroke="currentColor" stroke-width="2">
                                            <polyline points="3 6 5 6 21 6" />
                                            <path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6" />
                                            <path d="M10 11v6M14 11v6" />
                                            <path d="M9 6V4h6v2" />
                                        </svg>
                                    </button>
                                }
                                @if (permissions.Has(PermissionConstants.User_Inactive))
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-icon @(role.IsActive ? "btn-success" : "btn-secondary")"
                                            title="@(role.IsActive ? "Deactivate" : "Activate")"
                                            onclick="loadPopup('/User/ActiveInactive?userId=@role.RoleId&isActive=@role.IsActive.ToString().ToLower()','Change Status','sm')">

                                        @if (role.IsActive)
                                        {
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M12 2a10 10 0 100 20 10 10 0 000-20z" />
                                                <path d="M9 12l2 2 4-5" />
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <circle cx="12" cy="12" r="10" />
                                                <line x1="8" y1="12" x2="16" y2="12" />
                                            </svg>
                                        }
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6">
                        <div class="empty-state">
                            <img src="~/images/permission.png" />
                            <h5>No Roles Found</h5>
                            <p>
                                There are no roles available.<br />
                                Click <strong>Add Role</strong> to create one.
                            </p>

                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <partial name="_Pagination" model="Model.Pager" />
</div>