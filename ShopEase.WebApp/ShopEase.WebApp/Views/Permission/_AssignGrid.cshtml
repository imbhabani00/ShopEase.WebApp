@model ShopEase.WebApp.Models.Role.PermissionAssignViewModel 

@if (Model.Permissions == null || !Model.Permissions.Any())
{
    <div class="card">
        <div class="card__body" style="text-align:center;color:#aaa;padding:40px">
            No modules found for this role.
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card__header">
            <span class="card__title">
                Permissions for <strong>@Model.RoleName</strong>
            </span>
            <div class="d-flex gap-8">
                <button class="btn btn-primary btn-sm" id="savePermBtn"
                        onclick="savePermissions()">
                    <span class="btn-text">Save Permissions</span>
                    <span class="btn-spinner hidden"></span>
                </button>
            </div>
        </div>

        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Module</th>
                        <th style="width:110px;text-align:center">
                            <div>View</div>
                            <input type="checkbox" title="Toggle All"
                                   onchange="toggleAll('view', this.checked)" />
                        </th>
                        <th style="width:110px;text-align:center">
                            <div>Add</div>
                            <input type="checkbox" title="Toggle All"
                                   onchange="toggleAll('add', this.checked)" />
                        </th>
                        <th style="width:110px;text-align:center">
                            <div>Edit</div>
                            <input type="checkbox" title="Toggle All"
                                   onchange="toggleAll('edit', this.checked)" />
                        </th>
                        <th style="width:110px;text-align:center">
                            <div>Delete</div>
                            <input type="checkbox" title="Toggle All"
                                   onchange="toggleAll('delete', this.checked)" />
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var perm in Model.Permissions)
                    {
                        <tr class="perm-row"
                            data-module-id="@perm.ModuleId"
                            data-module-code="@perm.ModuleCode"
                            data-module-name="@perm.ModuleName">
                            <td class="fw-600">
                                @perm.ModuleName
                                <span class="badge badge-secondary"
                                      style="margin-left:6px;font-size:10px">
                                    @perm.ModuleCode
                                </span>
                            </td>
                            <td style="text-align:center">
                                <input type="checkbox" class="chk-view"
                                @(perm.CanView ? "checked" : "")
                                       style="accent-color:#534AB7;width:16px;height:16px" />
                            </td>
                            <td style="text-align:center">
                                <input type="checkbox" class="chk-add"
                                @(perm.CanAdd ? "checked" : "")
                                       style="accent-color:#534AB7;width:16px;height:16px" />
                            </td>
                            <td style="text-align:center">
                                <input type="checkbox" class="chk-edit"
                                @(perm.CanEdit ? "checked" : "")
                                       style="accent-color:#534AB7;width:16px;height:16px" />
                            </td>
                            <td style="text-align:center">
                                <input type="checkbox" class="chk-delete"
                                @(perm.CanDelete ? "checked" : "")
                                       style="accent-color:#534AB7;width:16px;height:16px" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}