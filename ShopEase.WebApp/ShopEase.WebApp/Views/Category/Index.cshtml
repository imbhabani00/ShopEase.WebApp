@{
    Layout = null;
    ViewData["Title"] = "Coming Soon";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ShopEase — Coming Soon</title>

    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 20px;
                background: #f4f5f7;
            }

            .card {
                background: #fff;
                border-radius: 16px;
                max-width: 460px;
                width: 100%;
                padding: 42px 34px;
                text-align: center;
                border: 1px solid #e5e7eb;
                box-shadow: 0 4px 16px rgba(0,0,0,.06);
            }

            .icon-circle {
                width: 72px;
                height: 72px;
                margin: 0 auto 22px;
                border-radius: 50%;
                background: #eff6ff;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .icon-circle svg {
                    width: 34px;
                    height: 34px;
                    stroke: #2563eb;
                }

            h1 {
                color: #111827;
                font-size: 24px;
                margin-bottom: 10px;
                font-weight: 700;
            }

            .msg {
                color: #4b5563;
                font-size: 15px;
                line-height: 1.7;
                margin-bottom: 8px;
            }

            .msg-small {
                color: #9ca3af;
                font-size: 14px;
                line-height: 1.6;
                margin-bottom: 28px;
            }

            .btn-home {
                display: inline-block;
                width: 100%;
                padding: 12px 20px;
                background: #2563eb;
                color: #fff;
                text-decoration: none;
                border-radius: 8px;
                font-size: 14px;
                font-weight: 600;
                transition: background .2s ease;
            }

                .btn-home:hover {
                    background: #1d4ed8;
                }

            .footer-note {
                margin-top: 22px;
                padding-top: 16px;
                border-top: 1px solid #f1f2f4;
                font-size: 13px;
                color: #9ca3af;
            }

            @@media (max-width:480px) {
                .card {
                    padding: 30px 24px;
                }
            }
    </style>
</head>
<body>

    <div class="card">

        <div class="icon-circle">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 8v4l3 2"></path>
                <circle cx="12" cy="12" r="10"></circle>
            </svg>
        </div>

        <h1>We'll Meet Soon 👋</h1>

        <p class="msg">
            This feature is currently under development.
        </p>

        <p class="msg-small">
            Our team is working hard to bring it to you. Stay tuned—we'll be back with something awesome very soon.
        </p>

        <a asp-controller="Dashboard" asp-action="Index" class="btn-home">
            Back to Dashboard
        </a>

        <div class="footer-note">
            🚀 Thank you for your patience and support.
        </div>

    </div>

</body>
</html>