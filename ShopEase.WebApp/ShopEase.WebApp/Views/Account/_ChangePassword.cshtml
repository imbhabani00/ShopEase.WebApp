@model ShopEase.WebApp.Models.Auth.ChangePasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Change Password";
    bool isForced = ViewBag.IsForced ?? false;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ShopEase — Change Password</title>
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastr@2.1.4/build/toastr.min.css" />
</head>
<body>

    <div class="auth-page">

        <!-- Left Branding Panel -->
        <div class="auth-left">
            <div class="auth-left__inner">
                <div class="brand">
                    <div class="brand__icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z" /><line x1="3" y1="6" x2="21" y2="6" /><path d="M16 10a4 4 0 01-8 0" /></svg>
                    </div>
                    <span class="brand__name">ShopEase</span>
                </div>

                <div class="auth-left__copy">
                    <h2>Keep your account<br />safe and secure</h2>
                    <p>Set a strong new password to continue using ShopEase.</p>
                </div>
            </div>
        </div>

        <!-- Right Form Panel -->
        <div class="auth-right">
            <div class="auth-form-wrap">

                <h1 class="auth-form__title">
                    @(isForced ? "Set a new password" : "Change password")
                </h1>
                <p class="auth-form__sub">
                    @(isForced
                        ? "Your password must be updated before you continue."
                        : "For your security, we'll verify it's you before changing your password.")
                </p>

                <div id="alertBox" class="alert alert--danger hidden"></div>

                @Html.AntiForgeryToken()

                @if (!isForced)
                {
                    <!-- STEP 1: Request OTP -->
                    <div id="otpRequestSection">
                        <p class="auth-form__sub">Click below to receive a one-time code on your registered email.</p>
                        <button type="button" class="btn-primary" id="sendOtpBtn">
                            <span class="btn-text">Send OTP</span>
                            <span class="btn-spinner hidden"></span>
                        </button>
                    </div>

                    <!-- STEP 2: Verify OTP -->
                    <div id="otpVerifySection" class="hidden">
                        <div class="form-group">
                            <label class="form-label">Enter OTP<span class="text-danger">*</span></label>
                            <div class="input-wrap">
                                <input type="text" maxlength="6" class="form-input" id="otpInput" placeholder="6-digit code" autocomplete="one-time-code" />
                            </div>
                            <span class="field-error" id="otpError"></span>
                            <div class="forgot-row">
                                <a href="javascript:void(0)" id="resendOtpLink" class="forgot-link">Resend OTP</a>
                            </div>
                        </div>
                        <button type="button" class="btn-primary" id="verifyOtpBtn">
                            <span class="btn-text">Verify OTP</span>
                            <span class="btn-spinner hidden"></span>
                        </button>
                    </div>
                }

                <!-- STEP 3: New password form -->
                <form id="changePasswordForm" class="@(isForced ? "" : "hidden")">
                    <div class="form-group">
                        <label class="form-label">New password<span class="text-danger">*</span></label>
                        <div class="input-wrap">
                            <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0110 0v4" /></svg>
                            <input type="password" maxlength="20" asp-for="NewPassword" class="form-input" placeholder="Min. 8 characters" autocomplete="new-password" id="newPassword" />
                            <button type="button" class="input-toggle" onclick="togglePassword('newPassword', this)" tabindex="-1">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="field-error"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Confirm new password<span class="text-danger">*</span></label>
                        <div class="input-wrap">
                            <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0110 0v4" /></svg>
                            <input type="password" maxlength="20" asp-for="ConfirmPassword" class="form-input" placeholder="Re-enter new password" autocomplete="new-password" id="confirmPassword" />
                            <button type="button" class="input-toggle" onclick="togglePassword('confirmPassword', this)" tabindex="-1">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                    </div>

                    <button type="submit" class="btn-primary" id="changePasswordBtn">
                        <span class="btn-text">Save new password</span>
                        <span class="btn-spinner hidden"></span>
                    </button>
                </form>

            </div>
        </div>
    </div>

    <script>
            var IsForced = @(isForced.ToString().ToLower());
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/toastr@2.1.4/build/toastr.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/common.js"></script>
    <script src="~/js/auth/changepassword.js"></script>
</body>
</html>