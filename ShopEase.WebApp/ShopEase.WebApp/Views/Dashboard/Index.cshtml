@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        .se-root {
            --ink: #151A24;
            --paper: #F2F3EF;
            --card: #FFFFFF;
            --primary: #1F3358;
            --primary-light: #2C4A7C;
            --accent: #FFB020;
            --accent-ink: #5C3A00;
            --sale: #DD4B39;
            --success: #1F8A5F;
            --muted: #6B7280;
            --line: #E4E3DC;
            --radius: 14px;
            --shadow: 0 2px 4px rgba(21,26,36,.04), 0 8px 24px rgba(21,26,36,.06);
            background: var(--paper);
            color: var(--ink);
            font-family: 'Inter',sans-serif;
            -webkit-font-smoothing: antialiased;
        }

            .se-root * {
                box-sizing: border-box;
            }

            .se-root h1, .se-root h2, .se-root h3, .se-root .display {
                font-family: 'Space Grotesk',sans-serif;
                letter-spacing: -0.01em;
            }

            .se-root a {
                text-decoration: none;
                color: inherit;
            }

            .se-root img {
                display: block;
                max-width: 100%;
            }

            .se-root button {
                font-family: inherit;
                cursor: pointer;
            }

            .se-root .wrap {
                max-width: 1240px;
                margin: 0 auto;
                padding: 0 24px;
            }

            /* ---------- Eyebrow / tag motif (signature element) ---------- */
            .se-root .tag-label {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                font-size: 11.5px;
                font-weight: 700;
                letter-spacing: .14em;
                text-transform: uppercase;
                padding: 5px 12px 5px 10px;
                position: relative;
            }

                .se-root .tag-label::before {
                    content: "";
                    width: 6px;
                    height: 6px;
                    border-radius: 50%;
                    background: currentColor;
                }

            /* ---------- Category strip ---------- */
            .se-root .cat-strip {
                background: var(--card);
                border-bottom: 1px solid var(--line);
                border-radius: 14px;
                margin-top: 16px;
            }

                .se-root .cat-strip .wrap {
                    display: flex;
                    gap: 8px;
                    overflow-x: auto;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    scrollbar-width: none;
                }

                    .se-root .cat-strip .wrap::-webkit-scrollbar {
                        display: none;
                    }

            .se-root .cat-chip {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 8px 16px;
                border-radius: 999px;
                border: 1px solid var(--line);
                font-size: 13.5px;
                font-weight: 600;
                white-space: nowrap;
                flex-shrink: 0;
                transition: .15s;
            }

                .se-root .cat-chip svg {
                    width: 16px;
                    height: 16px;
                    stroke: var(--primary);
                    fill: none;
                    stroke-width: 1.8;
                }

                .se-root .cat-chip:hover {
                    border-color: var(--primary);
                    background: var(--primary);
                    color: #fff;
                }

                    .se-root .cat-chip:hover svg {
                        stroke: #fff;
                    }

            /* ---------- Hero banner carousel ---------- */
            .se-root .hero {
                padding: 22px 0 0;
            }

            .se-root .hero-shell {
                position: relative;
                border-radius: 20px;
                overflow: hidden;
                height: 320px;
                box-shadow: var(--shadow);
            }

            .se-root .hero-track {
                display: flex;
                height: 100%;
                transition: transform .6s cubic-bezier(.65,0,.35,1);
            }

            .se-root .hero-slide {
                min-width: 100%;
                height: 100%;
                display: flex;
                align-items: center;
                padding: 0 60px;
                position: relative;
                color: #fff;
                overflow: hidden;
            }

                .se-root .hero-slide::after {
                    content: "";
                    position: absolute;
                    right: -60px;
                    top: 50%;
                    transform: translateY(-50%);
                    width: 260px;
                    height: 260px;
                    border-radius: 50%;
                    background: rgba(255,255,255,.08);
                }

                .se-root .hero-slide::before {
                    content: "";
                    position: absolute;
                    right: 36px;
                    top: 50%;
                    transform: translateY(-50%);
                    width: 160px;
                    height: 160px;
                    border-radius: 50%;
                    background: rgba(255,255,255,.07);
                }

            .se-root .hero-content {
                position: relative;
                z-index: 2;
                max-width: 440px;
            }

                .se-root .hero-content .tag-label {
                    background: rgba(255,255,255,.16);
                    color: #fff;
                    margin-bottom: 14px;
                }

                .se-root .hero-content h2 {
                    font-size: 34px;
                    line-height: 1.1;
                    margin: 0 0 12px;
                }

                .se-root .hero-content p {
                    font-size: 14.5px;
                    opacity: .85;
                    margin: 0 0 20px;
                    line-height: 1.5;
                }

            .se-root .hero-cta {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                background: var(--accent);
                color: var(--accent-ink);
                font-weight: 700;
                font-size: 14px;
                padding: 11px 20px;
                border-radius: 9px;
                border: 0;
            }

                .se-root .hero-cta:hover {
                    filter: brightness(1.05);
                }

            .se-root .hero-nav {
                position: absolute;
                top: 50%;
                transform: translateY(-50%);
                width: 36px;
                height: 36px;
                border-radius: 50%;
                background: rgba(255,255,255,.18);
                border: 0;
                color: #fff;
                display: flex;
                align-items: center;
                justify-content: center;
                z-index: 3;
                backdrop-filter: blur(2px);
            }

                .se-root .hero-nav:hover {
                    background: rgba(255,255,255,.32);
                }

                .se-root .hero-nav.prev {
                    left: 18px;
                }

                .se-root .hero-nav.next {
                    right: 18px;
                }

                .se-root .hero-nav svg {
                    width: 17px;
                    height: 17px;
                    stroke: #fff;
                    fill: none;
                    stroke-width: 2.2;
                }

            .se-root .hero-dots {
                position: absolute;
                bottom: 16px;
                left: 60px;
                display: flex;
                gap: 8px;
                z-index: 3;
            }

            .se-root .hero-dot {
                width: 22px;
                height: 5px;
                border-radius: 3px;
                background: rgba(255,255,255,.35);
                border: 0;
                padding: 0;
                cursor: pointer;
                transition: .2s;
            }

                .se-root .hero-dot.active {
                    background: #fff;
                    width: 30px;
                }

            /* ---------- Section header ---------- */
            .se-root .section {
                padding: 40px 0 6px;
            }

            .se-root .section-head {
                display: flex;
                align-items: baseline;
                justify-content: space-between;
                margin-bottom: 18px;
            }

                .se-root .section-head h3 {
                    font-size: 22px;
                    margin: 4px 0 0;
                }

                .se-root .section-head .tag-label {
                    color: var(--sale);
                }

                .se-root .section-head.alt .tag-label {
                    color: var(--success);
                }

            .se-root .see-all {
                font-size: 13.5px;
                font-weight: 700;
                color: var(--primary);
                display: flex;
                align-items: center;
                gap: 4px;
            }

                .se-root .see-all:hover {
                    opacity: .7;
                }

            .se-root .countdown {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-left: auto;
                margin-right: 26px;
                font-size: 13px;
                color: var(--muted);
                font-weight: 600;
            }

                .se-root .countdown span {
                    background: var(--ink);
                    color: #fff;
                    font-family: 'Space Grotesk',sans-serif;
                    padding: 4px 7px;
                    border-radius: 5px;
                    min-width: 28px;
                    text-align: center;
                }

            /* ---------- Product rows / grids ---------- */
            .se-root .h-scroll {
                display: flex;
                gap: 18px;
                overflow-x: auto;
                padding: 4px 4px 18px;
                scrollbar-width: none;
            }

                .se-root .h-scroll::-webkit-scrollbar {
                    display: none;
                }

                .se-root .h-scroll .card {
                    min-width: 210px;
                }

            .se-root .grid {
                display: grid;
                grid-template-columns: repeat(4,1fr);
                gap: 18px;
                padding-bottom: 8px;
            }

            .se-root .card {
                background: var(--card);
                border-radius: var(--radius);
                border: 1px solid var(--line);
                overflow: hidden;
                position: relative;
                transition: .18s ease;
            }

                .se-root .card:hover {
                    transform: translateY(-4px);
                    box-shadow: var(--shadow);
                    border-color: transparent;
                }

                .se-root .card .imgwrap {
                    position: relative;
                    aspect-ratio: 1/1;
                    background: #F4F4F1;
                    overflow: hidden;
                }

                    .se-root .card .imgwrap img {
                        width: 100%;
                        height: 100%;
                        object-fit: cover;
                        transition: .35s;
                    }

                .se-root .card:hover .imgwrap img {
                    transform: scale(1.06);
                }

            .se-root .badge {
                position: absolute;
                top: 10px;
                left: 10px;
                background: var(--sale);
                color: #fff;
                font-size: 11px;
                font-weight: 700;
                padding: 4px 9px;
                border-radius: 6px;
            }

                .se-root .badge.new {
                    background: var(--success);
                }

                .se-root .badge.best {
                    background: var(--ink);
                }

            .se-root .wishlist-btn {
                position: absolute;
                top: 10px;
                right: 10px;
                width: 30px;
                height: 30px;
                border-radius: 50%;
                background: rgba(255,255,255,.92);
                border: 0;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .se-root .wishlist-btn svg {
                    width: 15px;
                    height: 15px;
                    stroke: var(--ink);
                    fill: none;
                    stroke-width: 1.8;
                }

                .se-root .wishlist-btn:hover svg {
                    fill: var(--sale);
                    stroke: var(--sale);
                }

            .se-root .card .info {
                padding: 13px 14px 15px;
            }

            .se-root .card .name {
                font-size: 13.8px;
                font-weight: 600;
                line-height: 1.35;
                margin: 0 0 6px;
                height: 37px;
                overflow: hidden;
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
            }

            .se-root .rating {
                display: flex;
                align-items: center;
                gap: 4px;
                font-size: 12px;
                color: var(--muted);
                margin-bottom: 8px;
            }

                .se-root .rating svg {
                    width: 12px;
                    height: 12px;
                    fill: var(--accent);
                    stroke: none;
                }

            .se-root .price-row {
                display: flex;
                align-items: baseline;
                gap: 8px;
            }

            .se-root .price {
                font-family: 'Space Grotesk',sans-serif;
                font-weight: 700;
                font-size: 16.5px;
            }

            .se-root .old-price {
                font-size: 12.5px;
                color: #A6ABB4;
                text-decoration: line-through;
            }

            .se-root .add-btn {
                position: absolute;
                right: 12px;
                bottom: 12px;
                width: 34px;
                height: 34px;
                border-radius: 9px;
                background: var(--primary);
                border: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                opacity: 0;
                transform: translateY(6px);
                transition: .18s;
            }

            .se-root .card:hover .add-btn {
                opacity: 1;
                transform: none;
            }

            .se-root .add-btn svg {
                width: 16px;
                height: 16px;
                stroke: #fff;
                fill: none;
                stroke-width: 2;
            }

            /* ---------- Category tiles ---------- */
            .se-root .catgrid {
                display: grid;
                grid-template-columns: repeat(8,1fr);
                gap: 14px;
            }

            .se-root .cattile {
                background: var(--card);
                border: 1px solid var(--line);
                border-radius: 14px;
                padding: 18px 8px;
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 10px;
                text-align: center;
                transition: .15s;
            }

                .se-root .cattile:hover {
                    border-color: var(--primary);
                    transform: translateY(-3px);
                }

                .se-root .cattile .ico {
                    width: 44px;
                    height: 44px;
                    border-radius: 12px;
                    background: var(--paper);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                }

                    .se-root .cattile .ico svg {
                        width: 21px;
                        height: 21px;
                        stroke: var(--primary);
                        fill: none;
                        stroke-width: 1.6;
                    }

                .se-root .cattile span {
                    font-size: 12.5px;
                    font-weight: 600;
                }

            /* ---------- Perks strip ---------- */
            .se-root .perks {
                background: var(--card);
                border: 1px solid var(--line);
                border-radius: 14px;
                margin-top: 46px;
            }

                .se-root .perks .wrap {
                    display: grid;
                    grid-template-columns: repeat(4,1fr);
                    gap: 20px;
                    padding: 24px;
                }

            .se-root .perk {
                display: flex;
                align-items: center;
                gap: 12px;
            }

                .se-root .perk .ico {
                    width: 40px;
                    height: 40px;
                    border-radius: 10px;
                    background: var(--paper);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    flex-shrink: 0;
                }

                    .se-root .perk .ico svg {
                        width: 19px;
                        height: 19px;
                        stroke: var(--primary);
                        fill: none;
                        stroke-width: 1.6;
                    }

                .se-root .perk h4 {
                    font-size: 13.5px;
                    margin: 0 0 2px;
                }

                .se-root .perk p {
                    font-size: 12px;
                    color: var(--muted);
                    margin: 0;
                }

            /* ---------- Newsletter ---------- */
            .se-root .newsletter {
                background: var(--primary);
                color: #fff;
                border-radius: 14px;
                margin-top: 24px;
            }

                .se-root .newsletter .wrap {
                    padding: 40px 24px;
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    gap: 24px;
                }

                .se-root .newsletter h3 {
                    font-size: 22px;
                    margin: 0 0 6px;
                }

                .se-root .newsletter p {
                    margin: 0;
                    opacity: .8;
                    font-size: 14px;
                }

            .se-root .nl-form {
                display: flex;
                gap: 10px;
                flex-shrink: 0;
            }

                .se-root .nl-form input {
                    width: 250px;
                    padding: 11px 14px;
                    border-radius: 9px;
                    border: 0;
                    font-size: 13.5px;
                    font-family: inherit;
                }

                .se-root .nl-form button {
                    background: var(--accent);
                    color: var(--accent-ink);
                    border: 0;
                    padding: 11px 18px;
                    border-radius: 9px;
                    font-weight: 700;
                    font-size: 13.5px;
                }

        @@media (max-width: 980px) {
            .se-root .grid {
                grid-template-columns: repeat(2,1fr);
            }

            .se-root .catgrid {
                grid-template-columns: repeat(4,1fr);
            }

            .se-root .perks .wrap {
                grid-template-columns: repeat(2,1fr);
            }

            .se-root .hero-content h2 {
                font-size: 26px;
            }
        }

        @@media (max-width: 620px) {
            .se-root .catgrid {
                grid-template-columns: repeat(3,1fr);
            }

            .se-root .grid {
                grid-template-columns: repeat(2,1fr);
            }

            .se-root .newsletter .wrap {
                flex-direction: column;
                align-items: flex-start;
            }

            .se-root .hero-shell {
                height: 280px;
            }

            .se-root .hero-slide {
                padding: 0 26px;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .se-root .hero-track {
                transition: none;
            }

            .se-root .card {
                transition: none;
            }
        }
    </style>
}

<div class="se-root">

    <nav class="cat-strip">
        <div class="wrap">
            @foreach (var c in categories)
            {
                <a class="cat-chip" href="#">
                    <svg viewBox="0 0 24 24"><path d="@c.Icon" /></svg>
                    @c.Name
                </a>
            }
        </div>
    </nav>

    <!-- ================= HERO BANNER (auto-scrolling) ================= -->
    <section class="hero">
        <div class="wrap">
            <div class="hero-shell" id="heroShell">
                <div class="hero-track" id="heroTrack">
                    @foreach (var b in banners)
                    {
                        <div class="hero-slide" style="background:@b.Bg">
                            <div class="hero-content">
                                <span class="tag-label">@b.Tag</span>
                                <h2>@b.Title</h2>
                                <p>@b.Sub</p>
                                <button class="hero-cta">
                                    @b.Cta
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                                </button>
                            </div>
                        </div>
                    }
                </div>
                <button class="hero-nav prev" id="heroPrev" aria-label="Previous banner">
                    <svg viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6" /></svg>
                </button>
                <button class="hero-nav next" id="heroNext" aria-label="Next banner">
                    <svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6" /></svg>
                </button>
                <div class="hero-dots" id="heroDots"></div>
            </div>
        </div>
    </section>

    <!-- ================= FLASH DEALS ================= -->
    <section class="section">
        <div class="wrap">
            <div class="section-head">
                <div>
                    <span class="tag-label">Flash deals</span>
                    <h3>Today's Best Price Drops</h3>
                </div>
                <div class="countdown">
                    Ends in <span id="cdH">05</span>:<span id="cdM">42</span>:<span id="cdS">10</span>
                </div>
                <a class="see-all" href="#">
                    See all
