<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password — ShopEase</title>
    <style>
            /* ---------- RESET ---------- */
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                background: #f0f2f8;
                font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
                padding: 40px 20px;
                display: flex;
                align-items: center;
                justify-content: center;
                min-height: 100vh;
            }

            .container {
                max-width: 540px;
                width: 100%;
                background: #ffffff;
                border-radius: 24px;
                box-shadow: 0 12px 48px rgba(0, 0, 0, 0.06), 0 4px 12px rgba(0, 0, 0, 0.02);
                overflow: hidden;
            }

            /* ---------- HEADER ---------- */
            .header {
                background: linear-gradient(145deg, #0f0e1a, #1f1c3a);
                padding: 34px 32px 28px;
                text-align: center;
                position: relative;
            }

                .header::after {
                    content: '';
                    position: absolute;
                    bottom: 0;
                    left: 0;
                    right: 0;
                    height: 4px;
                    background: linear-gradient(90deg, #f59e0b, #fbbf24, #f59e0b);
                    background-size: 200% 100%;
                    animation: shimmer 3s ease-in-out infinite;
                }

            @@keyframes shimmer {
                0%,
                100% {
                    background-position: 0% 0%;
                }

                50% {
                    background-position: 100% 0%;
                }
            }

            .header .logo {
                font-size: 28px;
                font-weight: 700;
                color: #fff;
                letter-spacing: -0.5px;
            }

                .header .logo span {
                    color: #fbbf24;
                }

            .header .sub {
                color: rgba(255, 255, 255, 0.7);
                font-size: 14px;
                font-weight: 400;
                margin-top: 6px;
                letter-spacing: 0.3px;
            }

            .header .icon {
                font-size: 42px;
                display: block;
                margin-bottom: 6px;
            }

            /* ---------- BODY ---------- */
            .body {
                padding: 32px 34px 28px;
            }

            .greeting {
                font-size: 19px;
                font-weight: 700;
                color: #1a1a2e;
                margin-bottom: 12px;
            }

                .greeting strong {
                    color: #534AB7;
                }

            .body p {
                color: #4a4a5a;
                font-size: 15px;
                line-height: 1.8;
                margin-bottom: 14px;
            }

                .body p:last-of-type {
                    margin-bottom: 0;
                }

            .body .highlight {
                color: #f59e0b;
                font-weight: 600;
            }

            /* ---------- BUTTON ---------- */
            .btn-wrap {
                text-align: center;
                margin: 26px 0 16px;
            }

            .btn {
                display: inline-block;
                background: linear-gradient(135deg, #f59e0b, #fbbf24);
                color: #1a1a2e !important;
                text-decoration: none;
                padding: 14px 44px;
                border-radius: 60px;
                font-weight: 700;
                font-size: 15px;
                box-shadow: 0 8px 24px rgba(245, 158, 11, 0.35);
                transition: all 0.2s ease;
                border: none;
                cursor: pointer;
            }

                .btn:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 12px 32px rgba(245, 158, 11, 0.45);
                }

            /* ---------- RESET LINK BOX ---------- */
            .reset-link-box {
                background: #f5f6fa;
                padding: 14px 18px;
                border-radius: 10px;
                word-break: break-all;
                font-size: 13px;
                color: #6b6b80;
                margin: 10px 0 16px;
                border: 1px solid #e8eaf2;
                font-family: 'Courier New', monospace;
            }

            .link-label {
                font-size: 14px;
                color: #6b6b80;
                margin-top: 4px;
            }

            /* ---------- FOOTER ---------- */
            .footer {
                background: #fafbfd;
                padding: 20px 34px;
                text-align: center;
                border-top: 1px solid #eef0f5;
            }

                .footer p {
                    font-size: 12px;
                    color: #a0a0b0;
                    margin: 0;
                    line-height: 1.6;
                }

                    .footer p:first-child {
                        font-weight: 500;
                        color: #8888a0;
                    }

            /* ---------- RESPONSIVE ---------- */
            @@media (max-width: 600px) {
                body {
                    padding: 20px 12px;
                }

                .header {
                    padding: 26px 20px 22px;
                }

                    .header .logo {
                        font-size: 24px;
                    }

                .body {
                    padding: 24px 20px 20px;
                }

                .greeting {
                    font-size: 17px;
                }

                .btn {
                    padding: 12px 28px;
                    font-size: 14px;
                    width: 100%;
                }

                .footer {
                    padding: 16px 20px;
                }
            }
    </style>
</head>
<body>

    <div class="container">

        <!-- HEADER -->
        <div class="header">
            <span class="icon">🔑</span>
            <div class="logo">Shop<span>Ease</span></div>
            <div class="sub">Reset your password</div>
        </div>

        <!-- BODY -->
        <div class="body">

            <div class="greeting">Hi <strong>Alex Rivera</strong>,</div>

            <p>
                We received a request to reset your password. Click the button below to create a new one.
                This link is valid for <span class="highlight">1 hour</span>.
            </p>

            <!-- BUTTON -->
            <div class="btn-wrap">
                <a href="#" class="btn">Reset Password</a>
            </div>

            <!-- RESET LINK -->
            <p class="link-label">Or copy this link:</p>
            <div class="reset-link-box">
                https://shopease.com/reset?token=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
            </div>

            <p style="margin-top:16px;">
                If you didn't request this, just ignore this email — your password will stay safe.
            </p>

        </div>

        <!-- FOOTER -->
        <div class="footer">
            <p>© 2026 ShopEase. All rights reserved.</p>
            <p>This is an automated email. Please do not reply.</p>
        </div>

    </div>

</body>
</html>